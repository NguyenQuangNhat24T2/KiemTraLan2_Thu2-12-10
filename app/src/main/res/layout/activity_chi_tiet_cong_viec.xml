<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTieuDeChiTiet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chi tiet cong viec"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <!-- 1. Hien thi ma cong viec -->
    <TextView
        android:id="@+id/tvHienThiMa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ma cong viec: "
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHienThiTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ten cong viec: "
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHienThiMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mo ta cong viec: "
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHienThiTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Trang thai: Chua hoan thanh"
        android:textSize="16sp"
        android:textStyle="italic" />

    <!-- 2. Nut Hoan thanh -->
    <Button
        android:id="@+id/btnHoanThanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Hoan thanh" />

    <Button
        android:id="@+id/btnChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Chinh sua" />

</LinearLayout>