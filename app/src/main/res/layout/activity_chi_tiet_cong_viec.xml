<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTieuDeChiTiet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chi tiet cong viec"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvHienThiTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ten cong viec: "
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHienThiMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mo ta cong viec: "
        android:textSize="16sp" />

    <!-- Them vao cuoi LinearLayout cua activity_chi_tiet_cong_viec.xml -->
    <Button
        android:id="@+id/btnChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Chinh sua" />

</LinearLayout>