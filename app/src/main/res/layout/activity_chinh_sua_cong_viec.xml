<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTieuDeChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chinh sua cong viec"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/etChinhSuaTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Chinh sua ten cong viec"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/etChinhSuaMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Chinh sua mo ta cong viec"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/btnLuuChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Luu" />

</LinearLayout>