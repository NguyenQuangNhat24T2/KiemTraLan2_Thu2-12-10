<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 1. Thong tin sinh vien -->
    <TextView
        android:id="@+id/tvThongTinSinhVien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nguyen Quang Nhat - 2415053122226 - 24T2"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <!-- 2. O nhap ten cong viec -->
    <EditText
        android:id="@+id/etTenCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhap ten cong viec"
        android:minHeight="48dp" />

    <!-- 3. O nhap mo ta cong viec -->
    <EditText
        android:id="@+id/etMoTaCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Nhap mo ta cong viec"
        android:minHeight="48dp" />

    <!-- 4. Nut Tao cong viec -->
    <Button
        android:id="@+id/btnTaoCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tao cong viec" />

    <!-- 5. Nut Xem danh sach cong viec -->
    <Button
        android:id="@+id/btnXemDanhSach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Xem danh sach cong viec" />

</LinearLayout>